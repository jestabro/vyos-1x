def write_message(case):
    response = vycall_pb2.Result()
    response.output = case
    response.error = vycall_pb2.SUCCESS
    encoded_data = response.SerializeToString()
    byte_size = response.ByteSize()
    print(f'JSE type of encoded_data: {type(encoded_data)}')
    data_length = len(encoded_data)
    print(f'JSE write length: {data_length}')
    print(f'JSE ByteSize value: {byte_size}')
    data_length_bytes = data_length.to_bytes(4)
    arr = bytearray(data_length_bytes)
    arr.extend(encoded_data)
#    arr = bytearray(encoded_data)
#    arr.extend(data_length_bytes)
    arr_length = len(arr)
    print(f'JSE extended write length: {arr_length}')
#    print(f'JSE non-extended write length: {arr_length}')
    
    return arr


