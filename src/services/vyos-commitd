    request = vycall_pb2.CommitEnvelope()
    request.ParseFromString(msg)
    request = request.commit
    oneof_field = request.WhichOneof('msg')
    print(f'JSE request type is: {type(request)}')
    result = ''
    match oneof_field:
        case 'init':
            print(request.init.dry_run)
            result = 'Heard init\n'
        case 'call':
            print(request.call.script)
            result = 'Call and response\n'
    return result
